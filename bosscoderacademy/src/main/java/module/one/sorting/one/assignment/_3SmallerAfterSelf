package module.one.sorting.one.assignment;

import java.util.Arrays;

public class _3SmallerAfterSelf {

    public static void main(String[] args) {
        System.out.println("Smaller count after self: " + Arrays.toString(countSmaller(new int[]{8, 4, 2, 1})));
        System.out.println("Smaller count after self: " + Arrays.toString(countSmaller(new int[]{1, 20, 6, 4, 5})));
        System.out.println();
    }

    private static int[] countSmaller(int[] arr) {
        int n = arr.length;
        int[] res = new int[n];
        for (int i = 0; i < n - 1; i++) {
            int count = 0;
            for (int j = i + 1; j < n; j++) {
                if (arr[j] < arr[i]) {
                    count++;
                }
            }
            res[i] = count;
        }
        res[n - 1] = 0;
        return res;
    }

}