package module.one.arrays_and_maths.assignment;

public class _9MaxSubArray{

    public static void main(String[] args){
        printMaxSubArraySum(new int[]{-2,1,-3,4,-1,2,1,-5,4});
        printMaxSubArraySum(new int[]{5,4,-1,7,8});
        printMaxSubArraySum(new int[]{1});
    }

    private static void printMaxSubArraySum(int[] arr){
        int n = arr.length;
        if(n == 0){
            return;
        }
        int max = arr[0], currMax = 0;
        for(int num : arr){
            currMax = Math.max(currMax + num, num);
            max = Math.max(currMax, max);
        }
        System.out.println("Max sum of sub-array: " + max);
    }

}