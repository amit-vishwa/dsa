package module.one.maths.two.notes;

public class _3PrimeNumberCheck {

    public static void main(String[] args) {
        printIfPrimeNumber(10);
        printIfPrimeNumber(31);
        printIfPrimeNumber(101);
        printIfPrimeNumber(1053);
    }

    private static void printIfPrimeNumber(int n) {
        System.out.println("Approach 1: Is prime number: " + approach1(n));
        System.out.println("Approach 2: Is prime number: " + approach2(n));
        System.out.println("Approach 3: Is prime number: " + approach3(n));
        System.out.println();
    }

    private static boolean approach1(int n){
        for(int i = 2; i * i <= n; i++){
            if(n % i == 0){
                return false;
            }
        }
        return true;
    }

    private static boolean approach2(int n){
        int count = 0;
        for(int i = 1; i * i <= n && count <= 2; i++){
            if(n % i == 0){
                count = (i != n / i) ? count + 2 : count + 1;
            }
        }
        return (count == 2);
    }

    private static boolean approach3(int n){
        if(n <= 1){
            return false;
        }
        if(n == 2 || n == 3){
            return true;
        }
        if(n % 2 == 0 || n % 3 == 0){
            return false;
        }
        for(int i = 5; i * i <= n; i += 6){
            if(n % i == 0 || (n % (i + 2) == 0)){
                return false;
            }
        }
        return true;
    }

}