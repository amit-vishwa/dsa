package module.two.linkedlist.one.assignment;

import module.two.linkedlist.Node;
import module.two.linkedlist.ListNode;

public class _2MergeTwoSortedLists {

    public static void main(String[] args) {
        printSortedList(new ListNode().convertToLL(new int[]{1, 2, 4}), new ListNode().convertToLL(new int[]{1, 3, 4}));
        printSortedList(new ListNode().convertToLL(new int[]{1}), new ListNode().convertToLL(new int[]{0}));
    }

    private static void printSortedList(Node head1, Node head2) {
        Node sorted = new Node();
        Node temp = sorted;
        while (head1 != null && head2 != null) {
            if (head1.data <= head2.data) {
                temp.next = head1;
                head1 = head1.next;
            } else {
                temp.next = head2;
                head2 = head2.next;
            }
            temp = temp.next;
        }
        temp.next = (head1 != null) ? head1 : head2;
        ListNode.display(sorted.next);
        System.out.println();
    }

}