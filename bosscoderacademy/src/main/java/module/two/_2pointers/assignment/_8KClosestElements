package module.two._2pointers.assignment;

import java.util.Arrays;

public class _8KClosestElements {

    public static void main(String[] args) {
        System.out.println("K closest elements are " + Arrays.toString(kClosestElements(new int[]{1, 2, 3, 4, 5}, 4, 3)));
        System.out.println("K closest elements are " + Arrays.toString(kClosestElements(new int[]{1, 2, 3, 4, 5}, 4, -1)));
    }

    private static int[] kClosestElements(int[] arr, int k, int x) {
        int left = 0, right = arr.length - 1;
        while (right - left >= k) {
            if (arr[right] - x < x - arr[left]) {
                left++;
            } else {
                right--;
            }
        }
        int[] res = new int[k];
        for (int i = 0; i < k; i++) {
            res[i] = arr[left + i];
        }
        return res;
    }

}