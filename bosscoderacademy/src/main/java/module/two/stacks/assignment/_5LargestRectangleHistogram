package module.two.stacks.assignment;

import java.util.Stack;

public class _5LargestRectangleHistogram {

    public static void main(String[] args) {
        System.out.println("Largest rectangle area in histogram is " + largestRectangleArea(new int[]{2, 1, 5, 6, 2, 3}));
        System.out.println("Largest rectangle area in histogram is " + largestRectangleArea(new int[]{2, 4}));
    }

    private static int largestRectangleArea(int[] heights) {
        int maxArea = 0, n = heights.length;
        Stack<Integer> stack = new Stack<>();
        for (int i = 0; i <= n; i++) {
            int h = i == n ? 0 : heights[i];
            while (!stack.empty() && h < heights[stack.peek()]) {
                int height = heights[stack.pop()];
                int width = stack.empty() ? i : i - stack.peek() - 1;
                maxArea = Math.max(maxArea, height * width);
            }
            stack.push(i);
        }
        return maxArea;
    }

}