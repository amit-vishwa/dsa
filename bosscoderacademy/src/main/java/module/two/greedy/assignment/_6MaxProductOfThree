package module.two.greedy.assignment;

import java.util.Arrays;

public class _6MaxProductOfThree {

    public static void main(String[] args) {
        System.out.println("Maximum product of three numbers is " + maxProdThree(new int[]{1, 2, 3}));
        System.out.println("Maximum product of three numbers is " + maxProdThree(new int[]{1, 2, 3, 4}));
    }

    private static int maxProdThree(int[] nums) {
        Arrays.sort(nums);
        int n = nums.length;
        int product1 = nums[n - 1] * nums[n - 2] * nums[n - 3];
        int product2 = nums[0] * nums[1] * nums[n - 1];
        return Math.max(product1, product2);
    }

}