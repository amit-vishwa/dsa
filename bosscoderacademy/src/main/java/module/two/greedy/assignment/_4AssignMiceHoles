package module.two.greedy.assignment;

import java.util.Arrays;

public class _4AssignMiceHoles {

    public static void main(String[] args) {
        System.out.println("Minimum time taken by last mouse to reach hole is " + minTimeTaken(new int[]{4, -4, 2}, new int[]{4, 0, 5}));
        System.out.println("Minimum time taken by last mouse to reach hole is " + minTimeTaken(new int[]{4, 2}, new int[]{1, 7}));
    }

    private static int minTimeTaken(int[] mice, int[] holes) {
        Arrays.sort(mice);
        Arrays.sort(holes);
        int maxTimeTaken = 0;
        for (int i = 0; i < mice.length; i++) {
            int timeTaken = Math.abs(mice[i] - holes[i]);
            maxTimeTaken = Math.max(maxTimeTaken, timeTaken);
        }
        return maxTimeTaken;
    }

}